<?xml version="1.0" encoding="utf-8"?>
<!-- 电费组件 · 中号 (4x2)：剩余电量 + 本月用电/金额；右上角刷新按钮（融入本月用电行） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- 左：剩余电量（撑满高度，更新时间钉在左下角） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电费余额"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="30sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_balance_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="4dp"
                android:text="度"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="合闸"
            android:textSize="10sp"
            android:maxLines="1" />

        <!-- 撑开剩余空间，把更新时间推到组件最左下方 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tv_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 右：本月统计（首行含右上角刷新按钮） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <!-- 本月用电行：标签 + 刷新按钮（按钮占位 24dp，标签右对齐） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_label_month_kwh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="本月用电"
                android:textSize="10sp"
                android:maxLines="1" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <ImageButton
                    android:id="@+id/btn_dianfei_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ic_refresh"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:padding="1dp"
                    android:contentDescription="刷新电费" />

                <ProgressBar
                    android:id="@+id/pb_dianfei_refresh"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_month_kwh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="--"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- 本月金额行：标签 + 占位（与首行按钮等宽，保持数字右对齐） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_label_month_money"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="本月金额"
                android:textSize="10sp"
                android:maxLines="1" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_month_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="--"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
