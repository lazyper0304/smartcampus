<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application
        android:label="宜院宾果"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 文件文件共享：Android 7+ 通过 FileProvider 把内部缓存文件以
             content:// 形式安全暴露给 WPS 等外部应用，避免 FileUriExposedException -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/office_file_paths" />
        </provider>

        <!-- 桌面组件：课程表（小/中/大三档尺寸，拖拽自动切换） -->
        <receiver
            android:name=".widget.CourseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_course_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/course_widget_info" />
        </receiver>

        <!-- 桌面组件：课程表 4x2 固定尺寸（不支持拖拽放大的系统） -->
        <receiver
            android:name=".widget.CourseWidgetProvider4x2"
            android:exported="true"
            android:label="@string/widget_course_4x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/course_widget_info_4x2" />
        </receiver>

        <!-- 桌面组件：课程表 4x4 固定尺寸（不支持拖拽放大的系统） -->
        <receiver
            android:name=".widget.CourseWidgetProvider4x4"
            android:exported="true"
            android:label="@string/widget_course_4x4_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/course_widget_info_4x4" />
        </receiver>

        <!-- 桌面组件：电费（小/中/大三档尺寸，拖拽自动切换） -->
        <receiver
            android:name=".widget.DianfeiWidgetProvider"
            android:exported="true"
            android:label="@string/widget_dianfei_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dianfei_widget_info" />
        </receiver>

        <!-- 桌面组件：电费 4x2 固定尺寸（不支持拖拽放大的系统） -->
        <receiver
            android:name=".widget.DianfeiWidgetProvider4x2"
            android:exported="true"
            android:label="@string/widget_dianfei_4x2_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dianfei_widget_info_4x2" />
        </receiver>

        <!-- 桌面组件：电费 4x4 固定尺寸（不支持拖拽放大的系统） -->
        <receiver
            android:name=".widget.DianfeiWidgetProvider4x4"
            android:exported="true"
            android:label="@string/widget_dianfei_4x4_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dianfei_widget_info_4x4" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
